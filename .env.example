# ──────────────────────────────────────────────
# AI Business Copilot — Environment Variables
# ──────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aibusinesscopilot
DATABASE_SYNC_URL=postgresql://postgres:postgres@db:5432/aibusinesscopilot

# Security — замените на свой ключ (минимум 32 символа)
SECRET_KEY=your-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Providers (укажите хотя бы один)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-haiku

DEFAULT_AI_PROVIDER=openai

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Frontend
VITE_API_URL=http://localhost:8000/api

# Backend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Telegram Bot
WEB_APP_URL=http://localhost:5173