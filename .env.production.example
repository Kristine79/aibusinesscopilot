# ──────────────────────────────────────────────
# AI Business Copilot — Production Environment
# Скопируйте в .env.production и заполните реальными значениями
# ──────────────────────────────────────────────

# --- Database (Neon / serverless Postgres) ---
# Из дашборда Neon: Connection Details → pooled connection
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_SYNC_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Security (сгенерируйте свой ключ, минимум 32 символа) ---
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI Providers ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-haiku
DEFAULT_AI_PROVIDER=openai

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- Frontend (Vercel: Project → Settings → Environment Variables) ---
VITE_API_URL=/api

# --- Backend ---
BACKEND_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Telegram Bot ---
WEB_APP_URL=https://your-app.vercel.app
